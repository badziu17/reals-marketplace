// REALS — Prisma schema (Faza 0: fundament)
//
// Zakres tego pliku w Fazie 0: deklaracja modeli wynikających z README
// ("Data model", "State Management"), żeby kolejne iteracje (3 — API ofert,
// 1 — auth, 13 — messages) nie wymagały przepisywania struktury od zera.
// Pola oznaczone "// iteracja N" są przygotowane pod przyszłe funkcje, ale
// realnie zaczną być używane dopiero w danej iteracji.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketType {
  PIERWOTNY
  WTORNY
}

enum OfferType {
  KUP
  WYNAJEM
}

enum City {
  GDANSK
  GDYNIA
  SOPOT
}

// --- Auth (iteracja 1) -------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String? // null dla kont OAuth-only
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  savedListings  SavedListing[]
  listings       Listing[]        @relation("OwnerListings")
  preferences    UserPreferences?
  conversations  ConversationParticipant[]
  messages       Message[]
}

// NextAuth adapter models (Account/Session/VerificationToken) — iteracja 1
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Onboarding preferences (iteracja 10) -------------------------------

model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  areas     String[] // wybrane dzielnice (District.code)
  budget    Int?
  rooms     Int[]
  musts     String[] // udogodnienia must-have
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- District dictionary (iteracja 3, geokodowanie w iteracji 5) -------

model District {
  code      String  @id // np. "wrzeszcz", "orlowo"
  name      String
  city      City
  cx        Float // pozycja na schematycznej mapie (legacy/fallback)
  cy        Float
  lat       Float? // geokodowanie realne — iteracja 5
  lng       Float?
  fairPrice Int // zł/m², bazowa wartość dla AVM
  commute   String? // opis dojazdu
  noise     Int? // 0-100
  schools   Int? // 0-100

  listings Listing[]
}

// --- Listings (iteracja 3) ----------------------------------------------

model Listing {
  id           String      @id @default(cuid())
  districtCode String
  rooms        Int
  area         Float
  floor        Int?
  year         Int?
  market       MarketType
  type         OfferType
  price        Int
  amenities    String[]
  sources      String[] // biura pośredniczące — wejście dla dedup
  avmLow       Int?
  avmHigh      Int?
  fresh        DateTime    @default(now()) // ostatnia aktywność oferty
  gradient     String? // identyfikator gradientu placeholdera zdjęcia
  quality      Int         @default(0) // 0-99
  featured     Boolean     @default(false)
  status       ListingStatus @default(DRAFT) // iteracja 11 (Sell)
  ownerId      String?

  district District @relation(fields: [districtCode], references: [code])
  owner    User?    @relation("OwnerListings", fields: [ownerId], references: [id])

  savedBy       SavedListing[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtCode])
  @@index([type, market])
}

enum ListingStatus {
  DRAFT // iteracja 11 — w trakcie tworzenia przez Sell
  PUBLISHED
  ARCHIVED
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

// --- Messages (iteracja 13) ---------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  listingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing      Listing?                  @relation(fields: [listingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}
